{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建模组",
      "type": "shell",
      "command": "bash build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "清理构建产物",
      "type": "shell",
      "command": "bash -c \"rm -rf build\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
